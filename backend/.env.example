# Copy to .env and replace the placeholders with the connection string from Supabase > Connect.
# URL-encode reserved characters in the database password. TLS is enabled in src/config/db.js;
# do not add sslmode to this URL because node-postgres URL settings override the SSL options.
DATABASE_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION_MS=3600000
PORT=8081
APP_CORS_ALLOWED_ORIGIN=http://localhost:5173
ADMIN_BOOTSTRAP_NAME=
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
